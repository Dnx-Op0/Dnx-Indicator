generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VerificationStatus {
  ANNOUNCED
  CONFIRMED
  REVISED
  CANCELLED
  UNVERIFIED
}

enum SyncMode {
  INCREMENTAL
  FULL
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
  UNCONFIGURED
}

enum NotificationType {
  NEW_DIVIDEND
  DATE_CHANGE
  DIVIDEND_CANCELLED
  SYNC_FAILED
}

model Company {
  id            String     @id @default(cuid())
  name          String
  nseSymbol     String?    @unique
  bseCode       String?    @unique
  sector        String?
  description   String?
  marketCap     Decimal?   @db.Decimal(20, 2)
  dividendYield Decimal?   @db.Decimal(10, 4)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  dividends     Dividend[]
}

model Dividend {
  id                    String             @id @default(cuid())
  companyId             String
  company               Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  source                String
  sourceReference       String
  sourceRecordKey       String             @unique
  sourceAnnouncementUrl String?
  amount                Decimal            @db.Decimal(14, 4)
  percentage            Decimal?           @db.Decimal(10, 4)
  type                  String
  financialYear         String?
  announcementDate      DateTime           @db.Date
  sourcePublishedAt     DateTime?
  exDate                DateTime?          @db.Date
  recordDate            DateTime?          @db.Date
  paymentDate           DateTime?          @db.Date
  sourceRetrievedAt     DateTime
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  revisions             DividendRevision[]

  @@index([companyId, announcementDate])
  @@index([exDate])
  @@index([verificationStatus])
  @@index([source, sourceReference])
}

model DividendRevision {
  id         String   @id @default(cuid())
  dividendId String
  dividend   Dividend @relation(fields: [dividendId], references: [id], onDelete: Cascade)
  snapshot   Json
  recordedAt DateTime @default(now())

  @@index([dividendId, recordedAt])
}

model SyncRun {
  id               String     @id @default(cuid())
  mode             SyncMode
  status           SyncStatus @default(RUNNING)
  trigger          String
  startedAt        DateTime   @default(now())
  finishedAt       DateTime?
  attempts         Int        @default(0)
  companiesChecked Int        @default(0)
  detected         Int        @default(0)
  created          Int        @default(0)
  updated          Int        @default(0)
  errorCode        String?

  @@index([startedAt])
  @@index([status, startedAt])
}

model DeveloperNotification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  dedupeKey String?          @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([readAt, createdAt])
}
